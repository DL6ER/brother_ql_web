# Spelling check, run "codespell" in the repository (CI: the spelling job)
[codespell]
# Typos, and British spellings: the project uses American English
builtin = clear,rare,en-GB_to_en-US
check-hidden = true
# Vendored libraries and fonts, and the German demo labels (tools/spelling_de.py)
skip = ./.git,*.min.js,*-min.js,*.min.css,*.map,./app/labeldesigner/demos/*/*-de.json
