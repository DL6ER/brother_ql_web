              }
            }
          }
        }
      }
    },
    "/labeldesigner/api/repository/save": {
      "post": {
        "summary": "Save a label",
        "description": "Saves the label parameters under `name`. An image is sent as base64 in `image_data`.",
        "operationId": "repositorySave",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SavedLabel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "name": {
                      "type": "string",
                      "description": "File name of the saved label."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The request was refused, `message` says why.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "500": {
            "description": "The request was refused, `message` says why.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          }
        }
      }
    },
    "/labeldesigner/api/repository/load": {
      "get": {
        "summary": "Load a saved label",
        "operationId": "repositoryLoad",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "description": "File name of the saved label, e.g. `EAN-Label.json`.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The saved label, its image as base64 in `image_data`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedLabel"
                }
              }
            }
          },
          "400": {
            "description": "The request was refused, `message` says why.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "404": {
            "description": "The request was refused, `message` says why.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "500": {
            "description": "The request was refused, `message` says why.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          }
        }
      }
    },
    "/labeldesigner/api/repository/delete": {
