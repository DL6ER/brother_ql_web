        "responses": {
          "200": {
            "description": "The label as it is printed.",
            "headers": {
              "X-Label-Warning": {
                "description": "Set when text, a code or an image does not fit on the label and is cut off, or when a font is not installed and the default font is used instead.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
