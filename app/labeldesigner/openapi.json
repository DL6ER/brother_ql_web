{
  "openapi": "3.1.0",
  "info": {
    "title": "brother_ql_web",
    "version": "1",
    "description": "Everything the label designer does is available through this API. The label designer itself sends the same requests.\n\nRequests that print, save or delete labels are refused when a browser sends them from another website. Scripts and tools like `curl` are not affected. With `TRUSTED_HOSTS` set, requests for other host names are refused.\n\nErrors are returned with status 400 (or 404, 413, 500) and a JSON object with `message`."
  },
  "paths": {
    "/labeldesigner/api/preview": {
      "post": {
        "summary": "Generate the label image without printing",
        "operationId": "preview",
        "parameters": [
          {
            "name": "return_format",
            "in": "query",
            "description": "`png` returns the image, `base64` the image as base64 text.",
            "schema": {
              "type": "string",
              "enum": [
                "png",
                "base64"
              ],
              "default": "png"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Label"
                  }
                ]
              },
              "encoding": {
                "text": {
                  "contentType": "text/plain"
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Label"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The label as it is printed.",
            "headers": {
              "X-Label-Warning": {
                "description": "Set when text, a code or an image does not fit on the label and is cut off, or when a font is not installed and the default font is used instead.",
                "schema": {
                  "type": "string"
                }
              },
              "X-PDF-Pages": {
                "description": "Number of pages of an uploaded PDF.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Label-Orientation": {
                "description": "`auto` when the orientation was chosen to show an image largest, which `image_fit` does for an image without text on a die-cut label. `orientation` has no effect then.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "auto"
                  ]
                }
              }
            },
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string",
                  "description": "The PNG image as base64 (`return_format=base64`)."
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters, e.g. \"Font size is required\".",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "413": {
            "description": "The request or the text is too large.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          }
        }
      }
    },
    "/labeldesigner/api/print": {
      "post": {
        "summary": "Print a label",
        "operationId": "print",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Label"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "printer": {
                        "type": "string",
                        "description": "Printer to use: the configured one, `simulation`, `file:///dev/usb/lp<N>`, `usb://<vendor>:<product>` or `tcp://<host>`. Default: `PRINTER_PRINTER`."
                      },
                      "model": {
                        "type": "string",
                        "description": "Printer model, e.g. `QL-800`. Default: `PRINTER_MODEL`."
                      },
                      "print_count": {
                        "type": "integer",
                        "minimum": 1,
                        "default": 1,
                        "description": "Number of labels, at most `PRINT_MAX_COUNT` (default 100). `{{counter}}` counts up from label to label."
                      },
                      "cut_once": {
                        "type": "integer",
                        "enum": [
                          0,
                          1
                        ],
                        "default": 0,
                        "description": "1 cuts only after the last label."
                      }
                    }
                  }
                ]
              },
              "encoding": {
                "text": {
                  "contentType": "text/plain"
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Label"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "printer": {
                        "type": "string",
                        "description": "Printer to use: the configured one, `simulation`, `file:///dev/usb/lp<N>`, `usb://<vendor>:<product>` or `tcp://<host>`. Default: `PRINTER_PRINTER`."
                      },
                      "model": {
                        "type": "string",
                        "description": "Printer model, e.g. `QL-800`. Default: `PRINTER_MODEL`."
                      },
                      "print_count": {
                        "type": "integer",
                        "minimum": 1,
                        "default": 1,
                        "description": "Number of labels, at most `PRINT_MAX_COUNT` (default 100). `{{counter}}` counts up from label to label."
                      },
                      "cut_once": {
                        "type": "integer",
                        "enum": [
                          0,
                          1
                        ],
                        "default": 0,
                        "description": "1 cuts only after the last label."
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Printed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "Not printed, `message` says why, e.g. \"The printer reports: Replace media error\".",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          }
        }
      }
    },
    "/labeldesigner/api/printer_status": {
      "get": {
        "summary": "Status of the printers",
        "description": "With automatic detection (`PRINTER_PRINTER` not set), `printers` lists the detected printers and the simulator, the top-level fields describe the first one.",
        "operationId": "printerStatus",
        "responses": {
          "200": {
            "description": "The status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrinterStatus"
                }
              }
            }
          }
        }
      }
    },
    "/labeldesigner/api/barcodes": {
      "get": {
        "summary": "Supported code types",
        "operationId": "barcodes",
        "responses": {
          "200": {
            "description": "The code types for `barcode_type`.",
