    "/labeldesigner/api/repository/print": {
      "post": {
        "summary": "Print a saved label",
        "operationId": "repositoryPrint",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": false,
            "description": "File name of the saved label, also accepted as `name` in a JSON body or form.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "high_res": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "printer": {
                    "type": "string",
                    "description": "Printer to use: the configured one, `simulation`, `file:///dev/usb/lp<N>`, `usb://<vendor>:<product>` or `tcp://<host>`. Default: `PRINTER_PRINTER`."
                  },
                  "model": {
                    "type": "string",
                    "description": "Printer model, e.g. `QL-800`. Default: `PRINTER_MODEL`."
                  },
                  "print_count": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1,
                    "description": "Number of labels, at most `PRINT_MAX_COUNT` (default 100). `{{counter}}` counts up from label to label."
                  },
                  "cut_once": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "default": 0,
                    "description": "1 cuts only after the last label."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Printed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "The request was refused, `message` says why.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "404": {
            "description": "The request was refused, `message` says why.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "500": {
            "description": "The request was refused, `message` says why.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          }
        }
      }
    },
    "/labeldesigner/api/webhook/print": {
      "post": {
        "summary": "Print images, for other services",
        "description": "Prints one label per image, each image scaled to fit the label. On die-cut labels each image is turned to the orientation that shows it largest. The webhook is disabled unless `WEBHOOK_PASSWORD` is set. The password is sent as `Authorization: Bearer <password>`, as form field or as JSON field `password`, not in the URL.",
        "operationId": "webhookPrint",
        "security": [
          {
            "webhookPassword": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/WebhookOptions",
                "properties": {
                  "images": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              }
            },
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/WebhookOptions"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "images": {
                        "type": "array",
                        "items": {
                          "oneOf": [
                            {
                              "type": "string",
                              "description": "Image or PDF as base64."
                            },
                            {
                              "type": "object",
                              "properties": {
                                "data": {
                                  "type": "string",
                                  "description": "Image or PDF as base64."
                                },
                                "mime": {
                                  "type": "string",
                                  "examples": [
                                    "image/png",
                                    "application/pdf"
                                  ]
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Printed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "count": {
                      "type": "integer",
                      "description": "Number of labels."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The request was refused, `message` says why.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "401": {
            "description": "Wrong or missing password.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "403": {
            "description": "The webhook is disabled, `WEBHOOK_PASSWORD` is not set.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          }
        }
      }
    },
    "/labeldesigner/api/openapi.json": {
      "get": {
        "summary": "This description of the API",
        "operationId": "openapi",
        "responses": {
          "200": {
            "description": "OpenAPI description.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "webhookPassword": {
        "type": "http",
        "scheme": "bearer",
        "description": "The value of `WEBHOOK_PASSWORD`."
      }
    },
    "schemas": {
      "Result": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "description": "Why it failed."
          }
        }
      },
      "Message": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "TextLine": {
        "type": "object",
        "description": "One line of text. Templates like `{{datetime:%d.%m.%Y}}`, `{{counter}}`, `{{uuid}}`, `{{short-uuid}}`, `{{env:<var>}}` and `{{random}}` are filled in when the label is generated.",
        "required": [
          "text",
          "size"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 10000
          },
          "font": {
            "type": "string",
            "description": "Font as `<family>,<style>`, e.g. `DejaVu Sans,Book`. Default: the configured default font, which also replaces fonts that are not installed."
          },
          "size": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Font size in dots (300 dpi), e.g. `70`."
          },
          "align": {
            "type": "string",
            "enum": [
              "left",
              "center",
              "right"
            ],
            "default": "center"
          },
          "line_spacing": {
            "type": "string",
            "enum": [
              "100",
              "150",
              "200",
              "250",
              "300"
            ],
            "default": "100",
            "description": "Line spacing in percent."
          },
          "inverted": {
            "type": "boolean",
            "default": false,
            "description": "White text on black."
          },
          "checkbox": {
            "type": "boolean",
            "default": false,
            "description": "A checkbox in front of the line (to-do item)."
          },
          "color": {
            "type": "string",
            "enum": [
              "black",
              "red"
            ],
            "default": "black",
            "description": "Red needs a black/red/white roll and a printer that prints red."
          }
        }
      },
      "Label": {
        "type": "object",
        "description": "Parameters of a label. All are optional, the defaults are those of the label designer.",
        "properties": {
          "label_size": {
            "type": "string",
            "default": "62",
            "description": "Label size identifier of brother_ql, e.g. `62`, `62x29`, `103x164`, `d24`. The label designer lists them."
          },
          "orientation": {
            "type": "string",
            "enum": [
              "standard",
              "rotated"
            ],
            "default": "standard"
          },
          "high_res": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "default": 0,
            "description": "600 dpi printing along the label. Labels usually come out much darker, it is only confirmed for the QL-800. The QL-1100 series prints at 300 dpi only and refuses it."
          },
          "shrink_text": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "default": 0,
            "description": "Make all lines of text smaller by the same factor until they fit on the label, instead of cutting the text off."
          },
          "print_type": {
            "type": "string",
            "enum": [
              "text",
              "qrcode",
              "qrcode_text",
              "image"
            ],
            "default": "text",
            "description": "`qrcode` prints a code, `qrcode_text` a code with text, `image` an uploaded image or PDF (with optional text)."
          },
          "text": {
            "type": "string",
            "contentMediaType": "application/json",
            "description": "The lines of text as JSON array of `TextLine` objects.",
            "examples": [
              "[{\"text\": \"Hello\", \"size\": \"70\", \"font\": \"DejaVu Sans,Book\"}]"
            ]
          },
          "code_text": {
            "type": "string",
            "maxLength": 1000,
            "description": "Content of the code. Without it the code contains the text of all lines."
          },
          "barcode_type": {
            "type": "string",
            "default": "QR",
            "description": "One of `/labeldesigner/api/barcodes`."
          },
          "qrcode_size": {
            "type": "integer",
            "default": 10,
            "description": "Size of a QR code module in dots."
          },
          "qrcode_correction": {
            "type": "string",
            "enum": [
              "L",
              "M",
              "Q",
              "H"
            ],
            "default": "L"
          },
          "image": {
            "type": "string",
            "format": "binary",
            "description": "Image or PDF for `print_type=image`, as file upload. Printing takes several (the field repeated), each printed as a label of its own, of a PDF the pages `pdf_pages` selects. The preview uses the first."
          },
          "image_mode": {
            "type": "string",
            "enum": [
              "grayscale",
              "black_and_white",
              "red_and_black",
              "colored"
            ],
            "default": "grayscale"
          },
          "image_bw_threshold": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255,
            "default": 70,
            "description": "Brightness below which pixels print black in `black_and_white` mode."
          },
          "image_fit": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "default": 1,
            "description": "Fit the image to the label. On die-cut labels an image without text is also turned to the orientation that shows it largest."
          },
          "image_crop": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "default": 0,
            "description": "Crop the image to its content."
          },
          "image_scaling_factor": {
            "type": "number",
            "default": 100,
            "description": "Scale in percent, only without `image_fit`."
          },
          "image_rotation": {
            "type": "integer",
            "default": 0,
            "description": "Rotation in degrees."
          },
          "pdf_pages": {
            "type": "string",
            "default": "",
            "description": "Pages of a PDF to print, each as a label of its own, e.g. `1-3, 5`, `4-` or `all`. Default: the first page. Copies print the selection several times. The preview shows the first selected page.",
            "example": "1-3, 5"
          },
          "margin_top": {
            "type": "integer",
            "default": 24,
            "description": "Margins in dots, at 300 dpi about 12 dots are 1 mm."
          },
          "margin_bottom": {
            "type": "integer",
            "default": 24
          },
          "margin_left": {
            "type": "integer",
            "default": 35
          },
          "margin_right": {
            "type": "integer",
            "default": 35
          },
          "border_thickness": {
            "type": "integer",
            "default": 0,
            "description": "Border in dots, 0 prints no border."
          },
          "border_roundness": {
            "type": "integer",
            "default": 0,
            "description": "Corner radius of the border in dots."
          },
          "border_distance_x": {
            "type": "integer",
            "default": 0
          },
          "border_distance_y": {
            "type": "integer",
            "default": 0
          },
          "border_color": {
            "type": "string",
            "enum": [
              "black",
              "red"
            ],
            "default": "black"
          },
          "print_color": {
            "type": "string",
            "enum": [
              "black",
              "red"
            ],
            "default": "black"
          }
        }
      },
      "SavedLabel": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Label"
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Name to save the label under."
              },
              "image_data": {
                "type": "string",
                "description": "Image as base64."
              },
              "image_mime": {
                "type": "string",
                "examples": [
                  "image/png"
                ]
              }
            }
          }
        ]
      },
      "SavedLabelFile": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "examples": [
              "EAN-Label.json"
            ]
          },
          "mtime": {
            "type": "integer",
            "description": "Time saved, Unix time."
          },
          "size": {
            "type": "integer",
            "description": "File size in bytes."
          },
          "label_size": {
            "type": [
              "string",
              "null"
            ],
            "description": "Name of the label size."
          },
          "label_size_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Identifier of the label size, as `label_size` of a print request.",
            "examples": [
              "62"
            ]
          }
        }
      },
      "PrinterState": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Printer to pass as `printer`, e.g. `file:///dev/usb/lp0` or `simulation`."
          },
          "model": {
            "type": "string",
            "description": "Model reported by the printer, `Unknown` if it has not answered yet."
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Errors reported by the printer, or why it does not answer."
          },
          "media_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "media_width": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Width of the loaded roll in mm."
          },
          "media_length": {
            "type": "integer",
            "description": "Length of die-cut labels in mm, 0 for endless rolls."
          },
          "status_type": {
            "type": "string",
            "description": "e.g. `Reply to status request`, `Printing`, `Error`, `Simulator`."
          },
          "phase_type": {
            "type": "string"
          },
          "red_support": {
            "type": "boolean",
            "description": "The printer prints red."
          }
        }
      },
      "PrinterStatus": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PrinterState"
          },
          {
            "type": "object",
            "properties": {
              "printers": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/PrinterState"
                }
              },
              "selected": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Printer used when a request names none."
              }
            }
          }
        ]
      },
      "WebhookOptions": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "description": "Alternative to the Authorization header."
          },
          "label_size": {
            "type": "string",
            "description": "Default: `LABEL_DEFAULT_SIZE`."
          },
          "orientation": {
            "type": "string",
            "enum": [
              "standard",
              "rotated"
            ]
          },
          "image_mode": {
            "type": "string",
            "enum": [
              "grayscale",
              "black_and_white",
              "red_and_black",
              "colored"
            ]
          },
          "bw_threshold": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          },
          "high_res": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "printer": {
            "type": "string",
            "description": "Printer to use: the configured one, `simulation`, `file:///dev/usb/lp<N>`, `usb://<vendor>:<product>` or `tcp://<host>`. Default: `PRINTER_PRINTER`."
          },
          "model": {
            "type": "string",
            "description": "Printer model, e.g. `QL-800`. Default: `PRINTER_MODEL`."
          }
        }
      }
    }
  }
}
