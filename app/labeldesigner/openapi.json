              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "barcodes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "examples": [
                        [
                          "QR",
                          "CODE128",
                          "EAN13"
                        ]
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/labeldesigner/api/repository/list": {
      "get": {
        "summary": "List the saved labels",
        "operationId": "repositoryList",
        "responses": {
          "200": {
            "description": "The saved labels.",
