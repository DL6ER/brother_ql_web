[Unit]
Description=Labelburg
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/labelburg
ExecStart=/opt/labelburg/.venv/bin/gunicorn --workers 3 --error-logfile /var/log/gunicorn/labelburg.log --bind 0.0.0.0:5000 -m 007 wsgi:app

[Install]
WantedBy=multi-user.target
